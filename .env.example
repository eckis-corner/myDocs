# Kopieren nach .env und anpassen. Die Datei .env niemals ins Repository einchecken.

# Langes, zufälliges Passwort für PostgreSQL (z. B. openssl rand -hex 24)
POSTGRES_PASSWORD=bitte-aendern

# Image-Version: latest oder eine feste Version wie 0.1.0
MYDOCS_VERSION=latest

# Port auf der Synology, an den der Nginx Proxy Manager weiterleitet
MYDOCS_PORT=8090

# Ablage aller Daten (Datenbank, Dateien, Schlüssel, Sicherungen) – dieses Verzeichnis sichert das Synology-Backup
MYDOCS_DATA_DIR=./data
# Scan-Ordner (Freigabe, in die der Scanner schreibt), z. B. /volume1/scan/mydocs
MYDOCS_SCAN_DIR=./data/scan

# Schlüssel für die tägliche Sicherung (openssl rand -base64 32). Getrennt von den Sicherungen aufbewahren,
# etwa ausgedruckt mit den 24 Wörtern des Hauptschlüssels: Ohne ihn lässt sich keine Sicherung zurückspielen.
MYDOCS_BACKUP_KEY=

# Adresse von myLife für den Abgleich (M5), z. B. https://mylife.eckis-corner.de. Leer: keine Brücke.
# In myLife gehört umgekehrt die Adresse von myDocs nach MYLIFE_MYDOCS_URL.
MYDOCS_MYLIFE_URL=

TZ=Europe/Berlin

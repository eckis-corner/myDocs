<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <base href="/" />
    <title>myDocs</title>
    <meta name="theme-color" content="#f3f6f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111519" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MyDocs.UI/css/app.css"]" />
    @* Kein <ImportMap />: Es wäre ein Inline-Skript und verstößt gegen die strikte CSP (script-src ohne unsafe-inline). *@
    <HeadOutlet @rendermode="_renderMode" />
</head>

<body>
    <Routes @rendermode="_renderMode" />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_content/MyDocs.UI/js/mydocs.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Wie myLife ohne Prerendering (39): Browser und Desktop-Client führen dieselbe Oberfläche aus, der Server liefert nur die Hülle.
    private static readonly IComponentRenderMode _renderMode = new InteractiveWebAssemblyRenderMode(prerender: false);
}

@* Aktivierungslink zum Weitergeben: einmal gültig, sieben Tage. Mit eingerichtetem SMTP geht er zusätzlich per Mail an das Konto. *@
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime Js

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText>@L["ActivationLinkText", Name, Expires.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)]</MudText>
            @if (Mailed)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense data-testid="activation-mailed">@L["ActivationLinkMailed"]</MudAlert>
            }
            <MudTextField T="string" Value="@Link" ReadOnly Variant="Variant.Outlined" Lines="3" UserAttributes="@(new() { ["data-testid"] = "activation-link" })" />
            @if (_copied)
            {
                <MudText Typo="Typo.body2" Color="Color.Success">@L["Copied"]</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CopyAsync" StartIcon="@Icons.Material.Filled.ContentCopy">@L["CopyLink"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Dialog.Close()">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _copied;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string Link { get; set; } = string.Empty;

    [Parameter] public string Name { get; set; } = string.Empty;

    [Parameter] public DateTimeOffset Expires { get; set; }

    [Parameter] public bool Mailed { get; set; }

    private async Task CopyAsync() => _copied = await Js.InvokeAsync<bool>("myDocs.copyText", Link);
}

@* Dokumente eines Objekts (M1.5): hochladen, neue Version, Vorschau, Download, Angaben ändern, löschen. *@
@inject IStringLocalizer<SharedResource> L
@inject DocumentClient Documents
@inject DocumentLinks Links
@inject AppInfoClient AppInfo
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="1" data-testid="documents">
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2"><b>@L["DocumentsTitle"]</b></MudText>
        <MudSpacer />
        @if (CanEdit)
        {
            <InputFile id="@_uploadId" class="mydocs-hidden-input" OnChange="UploadAsync" multiple data-testid="document-input" />
            <MudButton HtmlTag="label" for="@_uploadId" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile"
                       Disabled="_busy" data-testid="document-upload">@L["DocumentUpload"]</MudButton>
        }
    </MudStack>
    @if (_busy)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-2" />
    }

    @if (CanEdit)
    {
        <FileDropZone OnChange="UploadAsync" Disabled="_busy" TestId="document-drop" />
    }

    @if (_documents is null)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else if (_documents.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mydocs-muted">@L["DocumentsEmpty", _maxMb]</MudText>
    }
    else
    {
        <MudSimpleTable Dense Elevation="0" Hover>
            <tbody>
                @foreach (var document in _documents)
                {
                    <tr data-testid="document-row">
                        <td style="width: 56px">
                            @if (document.Current.HasThumbnail)
                            {
                                <img src="@Links.Thumbnail(document.Id)" alt="" loading="lazy" class="mydocs-thumbnail" data-testid="document-thumbnail" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Description" Class="mydocs-muted" />
                            }
                        </td>
                        <td>
                            <MudStack Spacing="0">
                                @if (document.Current.PreviewType is not null)
                                {
                                    <MudLink OnClick="() => PreviewAsync(document)">@document.Title</MudLink>
                                }
                                else
                                {
                                    <MudLink Href="@Links.Download(document.Id)" OnClick="() => OpenAsync(document, null)">@document.Title</MudLink>
                                }
                                <MudText Typo="Typo.caption" Class="mydocs-muted">
                                    @document.Current.FileName · @FormatSize(document.Current.Size)@(document.DocumentDate is { } date ? $" · {date.ToString("d", CultureInfo.CurrentCulture)}" : string.Empty)
                                    @if (document.Versions.Count > 1)
                                    {
                                        <text> · @L["DocumentVersions", document.Versions.Count]</text>
                                    }
                                </MudText>
                                @if (document.LockedByName is { } lockedBy)
                                {
                                    <MudText Typo="Typo.caption" Color="@(document.LockedByMe ? Color.Primary : Color.Warning)" data-testid="document-locked">
                                        @(document.LockedByMe
                                            ? L["DocumentLockedByMe", document.LockedAt?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) ?? string.Empty]
                                            : L["DocumentLockedBy", lockedBy, document.LockedAt?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) ?? string.Empty])
                                    </MudText>
                                }
                                @if (document.HasMacros)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning" data-testid="document-macros">@L["DocumentHasMacros"]</MudText>
                                }
                                @if (document.Current.Processing == ProcessingStates.Pending)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Info" data-testid="document-processing">@L["DocumentProcessing"]</MudText>
                                }
                                else if (document.Current.Processing == ProcessingStates.Failed)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning" data-testid="document-processing-failed">@L["DocumentProcessingFailed"]</MudText>
                                }
                            </MudStack>
                        </td>
                        <td style="text-align: right; white-space: nowrap">
                            @if (CanEdit && document.CanEdit)
                            {
                                <InputFile id="@($"version-{document.Id}")" class="mydocs-hidden-input" OnChange="args => AddVersionAsync(document, args)" />
                                <MudTooltip Text="@L["DocumentNewVersion"]">
                                    <MudIconButton HtmlTag="label" for="@($"version-{document.Id}")" Icon="@Icons.Material.Outlined.Upload" aria-label="@L["DocumentNewVersion"]" Size="Size.Small" />
                                </MudTooltip>
                            }
                            @if (Desktop is not null && CanEdit && document.CanEdit && (document.LockedByName is null || document.LockedByMe))
                            {
                                <MudTooltip Text="@L["DocumentEdit"]">
                                    <MudIconButton Icon="@Icons.Material.Outlined.EditNote" Size="Size.Small" aria-label="@L["DocumentEdit"]" OnClick="() => RunAsync(() => Desktop.EditAsync(document.Id))"
                                                   data-testid="document-edit" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@L["Download"]">
                                <MudIconButton Icon="@(Links.IsDesktop ? Icons.Material.Outlined.OpenInNew : Icons.Material.Filled.Download)" Href="@Links.Download(document.Id)" OnClick="() => OpenAsync(document, null)" aria-label="@L["Download"]" Size="Size.Small" />
                            </MudTooltip>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@L["Actions"]" Dense Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                @if (CanEdit && document.CanEdit)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="() => EditAsync(document)">@L["Edit"]</MudMenuItem>
                                }
                                @foreach (var version in document.Versions.Skip(1))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.History" Href="@Links.Download(document.Id, version.Number)" OnClick="() => OpenAsync(document, version)">
                                        @L["DocumentVersionDownload", version.Number, version.CreatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture), version.CreatedByName]
                                    </MudMenuItem>
                                }
                                @if (Desktop is not null && Desktop.Checkouts.Any(c => c.DocumentId == document.Id))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.TaskAlt" OnClick="() => CheckInAsync(document)">@L["DocumentCheckIn"]</MudMenuItem>
                                }
                                else if (document.LockedByName is not null && (document.LockedByMe || _isAdmin))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.LockOpen" OnClick="() => RunAsync(() => Documents.CheckInAsync(document.Id))" data-testid="document-release">@L["DocumentReleaseLock"]</MudMenuItem>
                                }
                                @if (CanEdit && document.CanEdit)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="() => DeleteAsync(document)">@L["Delete"]</MudMenuItem>
                                }
                            </MudMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    private List<DocumentDto>? _documents;
    private bool _busy;
    private int _maxMb = 100;

    [Parameter, EditorRequired] public Guid ObjectId { get; set; }

    [Parameter] public bool CanEdit { get; set; }

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? Authentication { get; set; }

    [Inject] private IServiceProvider Services { get; set; } = default!;

    private IDesktopPlatform? Desktop => Services.GetService<IDesktopPlatform>();

    private bool _isAdmin;

    private Task CheckInAsync(DocumentDto document) => RunAsync(async () =>
    {
        if (await Desktop!.CheckInAsync(document.Id))
        {
            Snackbar.Add(L["DocumentCheckedIn", document.Title], Severity.Success);
        }
        else
        {
            Snackbar.Add(L["CheckInBlocked"], Severity.Warning);
        }
    });

    protected override async Task OnParametersSetAsync()
    {
        _isAdmin = Authentication is not null && (await Authentication).User.IsInRole(HouseholdRoles.Admin);
        try
        {
            _documents = await Documents.ListAsync(ObjectId);
        }
        catch (ApiException exception)
        {
            _documents = [];
            Snackbar.Add(L[$"DocumentError_{exception.Code}"], Severity.Error);
        }

        try
        {
            _maxMb = (await AppInfo.GetAsync())?.MaxFileSizeMegabytes ?? _maxMb;
        }
        catch (HttpRequestException)
        {
        }
    }

    private long MaxBytes => _maxMb * 1024L * 1024L;

    private readonly string _uploadId = $"upload-{Guid.NewGuid():N}";

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles(20);

        await RunAsync(async () =>
        {
            foreach (var file in files)
            {
                if (file.Size > MaxBytes)
                {
                    Snackbar.Add(L["DocumentError_too-large", file.Name, _maxMb], Severity.Warning);
                    continue;
                }

                await using var stream = file.OpenReadStream(MaxBytes);
                await Documents.UploadAsync(ObjectId, stream, file.Name, file.ContentType);
            }
        });
    }

    private async Task AddVersionAsync(DocumentDto document, InputFileChangeEventArgs args)
    {
        var file = args.File;

        if (file.Size > MaxBytes)
        {
            Snackbar.Add(L["DocumentError_too-large", file.Name, _maxMb], Severity.Warning);
            return;
        }

        await RunAsync(async () =>
        {
            await using var stream = file.OpenReadStream(MaxBytes);
            await Documents.AddVersionAsync(document.Id, stream, file.Name, file.ContentType);
            Snackbar.Add(L["DocumentVersionAdded"], Severity.Success);
        });
    }

    private async Task PreviewAsync(DocumentDto document)
    {
        var parameters = new DialogParameters<DocumentPreviewDialog>
        {
            { d => d.Url, Links.Preview(document.Id) },
            { d => d.DownloadUrl, Links.Download(document.Id) },
            { d => d.DocumentId, document.Id },
            { d => d.FileName, document.Current.FileName },
            { d => d.Title, document.Title },
            { d => d.ContentType, document.Current.PreviewType ?? document.Current.ContentType },
        };
        await Dialogs.ShowAsync<DocumentPreviewDialog>(document.Title, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
    }

    /// <summary>Im Desktop-Client: mit der Standard-App öffnen; im Browser folgt der Link selbst.</summary>
    private Task OpenAsync(DocumentDto document, DocumentVersionDto? version) =>
        Links.IsDesktop ? Links.OpenAsync(document.Id, version?.Number, (version ?? document.Current).FileName) : Task.CompletedTask;

    private async Task EditAsync(DocumentDto document)
    {
        var parameters = new DialogParameters<DocumentDialog> { { d => d.Document, document } };
        var dialog = await Dialogs.ShowAsync<DocumentDialog>(L["Edit"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: DocumentUpdateRequest request })
        {
            await RunAsync(() => Documents.UpdateAsync(document.Id, request));
        }
    }

    private async Task DeleteAsync(DocumentDto document)
    {
        if (await Dialogs.ShowMessageBoxAsync(L["Delete"], L["DocumentDeleteConfirm", document.Title].Value, L["Delete"], L["Cancel"]) == true)
        {
            await RunAsync(() => Documents.DeleteAsync(document.Id));
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            Snackbar.Add(L[$"DocumentError_{exception.Code}"], Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["DesktopOffline"], Severity.Warning);
        }
        finally
        {
            _busy = false;
            try
            {
                _documents = await Documents.ListAsync(ObjectId);
            }
            catch (HttpRequestException)
            {
            }
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024d:0.#} KB",
        _ => $"{bytes / 1024d / 1024d:0.#} MB",
    };
}

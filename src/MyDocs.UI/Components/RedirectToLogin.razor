@* Ohne Anmeldung zur Anmeldeseite; ist myDocs noch nicht eingerichtet, zum Einrichtungsassistenten. *@
@inject NavigationManager Navigation
@inject AuthClient Auth
@inject IServiceProvider Services

@code {
    protected override async Task OnInitializedAsync()
    {
        // Der Desktop-Client meldet sich über den Systembrowser an, nicht über die Anmeldeseite.
        if (Services.GetService<IDesktopPlatform>() is { } desktop)
        {
            desktop.ShowConnect();
            return;
        }

        var setupRequired = false;
        try
        {
            setupRequired = (await Auth.GetSetupStatusAsync()).Required;
        }
        catch (HttpRequestException)
        {
            // Ohne Server zeigt die Anmeldeseite den Fehler.
        }

        var returnUrl = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo(setupRequired ? "setup" : string.IsNullOrEmpty(returnUrl) ? "login" : $"login?returnUrl={returnUrl}");
    }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Gesamte Oberfläche als Razor Class Library, gehostet im Browser (MyDocs.Web) und später im Desktop-Client (37). -->
  <PropertyGroup>
    <RootNamespace>MyDocs.UI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseMyCommonSource)' == 'true'">
    <ProjectReference Include="$(MyCommonDir)src\MyCommon.Ui\MyCommon.Ui.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseMyCommonSource)' != 'true'">
    <PackageReference Include="MyCommon.Ui" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyDocs.Shared\MyDocs.Shared.csproj" />
    <ProjectReference Include="..\MyDocs.ApiClient\MyDocs.ApiClient.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyDocs.Tests" />
  </ItemGroup>
</Project>

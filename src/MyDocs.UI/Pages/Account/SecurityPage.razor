@page "/account/security"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResource> L
@inject AuthClient Auth
@inject SessionService Session
@inject WebAuthnService WebAuthn
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@L["AppName"] – @L["SecurityTitle"]</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@L["SecurityTitle"]</MudText>

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2"><b>@L["PasskeysTitle"]</b></MudText>
            <MudText>@L["PasskeysIntro"]</MudText>
            @if (_passkeys is null)
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" />
            }
            else
            {
                <MudSimpleTable Dense Elevation="0" data-testid="passkeys">
                    <tbody>
                        @foreach (var passkey in _passkeys)
                        {
                            <tr>
                                <td>@passkey.Name</td>
                                <td class="mydocs-muted">@passkey.CreatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</td>
                                <td style="text-align: right">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" aria-label="@L["Delete"]" OnClick="() => RemoveAsync(passkey)" />
                                </td>
                            </tr>
                        }
                        @if (_passkeys.Count == 0)
                        {
                            <tr><td class="mydocs-muted">@L["PasskeysNone"]</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
                @if (_supported)
                {
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField T="string" @bind-Value="_name" Label="@L["PasskeyName"]" Placeholder="@L["PasskeyNameExample"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="max-width: 18rem" UserAttributes="@(new() { ["data-testid"] = "passkey-name" })" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key" OnClick="AddAsync" Disabled="_busy" data-testid="passkey-add">@L["PasskeyAdd"]</MudButton>
                    </MudStack>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["PasskeyUnsupported"]</MudAlert>
                }
            }
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2"><b>@L["RecoveryCodesTitle"]</b></MudText>
        <MudText data-testid="recovery-left">@L["RecoveryCodesLeft", Session.Me?.RecoveryCodesLeft ?? 0]</MudText>
    </MudPaper>
</MudStack>

@code {
    private List<PasskeyDto>? _passkeys;
    private bool _supported;
    private bool _busy;
    private string? _name;

    protected override async Task OnInitializedAsync()
    {
        await Session.RefreshAsync();
        _passkeys = await Auth.PasskeysAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _supported = await WebAuthn.IsSupportedAsync();
            StateHasChanged();
        }
    }

    private async Task AddAsync()
    {
        _busy = true;
        try
        {
            var options = await Auth.PasskeyCreationOptionsAsync();
            if (await WebAuthn.CreateAsync(options.OptionsJson) is not { } credential)
            {
                Snackbar.Add(L["PasskeyCancelled"], Severity.Info);
                return;
            }

            await Auth.AddPasskeyAsync(credential, string.IsNullOrWhiteSpace(_name) ? L["PasskeyNameExample"] : _name);
            _name = null;
            Snackbar.Add(L["PasskeyAdded"], Severity.Success);
            _passkeys = await Auth.PasskeysAsync();
        }
        catch (ApiException exception)
        {
            Snackbar.Add(L[$"AuthError_{exception.Code}"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(PasskeyDto passkey)
    {
        if (await Dialogs.ShowMessageBoxAsync(L["Delete"], L["PasskeyRemoveConfirm", passkey.Name].Value, L["Delete"], L["Cancel"]) == true)
        {
            await Auth.RemovePasskeyAsync(passkey.Id);
            _passkeys = await Auth.PasskeysAsync();
        }
    }
}

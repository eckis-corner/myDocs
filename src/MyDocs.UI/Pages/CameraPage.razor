@page "/inbox/camera"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = HouseholdRoles.Member)]
@* Kamera-Upload (M3.4, 23): Seiten sammeln, sortieren, drehen, grob zuschneiden; den Rest macht der Server. *@
@implements IAsyncDisposable
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime Js
@inject InboxClient Inbox
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@L["AppName"] – @L["CameraTitle"]</PageTitle>

<MudStack Spacing="3">
    <MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="inbox" aria-label="@L["InboxTitle"]" />
        <MudText Typo="Typo.h4" HtmlTag="h1">@L["CameraTitle"]</MudText>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mydocs-muted">@L["CameraIntro"]</MudText>

    <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
        <InputFile @ref="_take" id="camera-take" class="mydocs-hidden-input" accept="image/*" capture="environment" OnChange="AddAsync" data-testid="camera-take-input" />
        <MudButton HtmlTag="label" for="camera-take" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera"
                   Disabled="@(_busy || _pages.Count >= CameraLimits.MaxPages)">@L["CameraTake"]</MudButton>
        <InputFile @ref="_pick" id="camera-pick" class="mydocs-hidden-input" accept="image/*" multiple OnChange="AddAsync" />
        <MudButton HtmlTag="label" for="camera-pick" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Collections"
                   Disabled="@(_busy || _pages.Count >= CameraLimits.MaxPages)">@L["CameraPick"]</MudButton>
    </MudStack>

    @if (_pages.Count == 0)
    {
        <MudText Class="mydocs-muted" data-testid="camera-empty">@L["CameraEmpty"]</MudText>
    }
    else
    {
        <MudGrid Spacing="2">
            @for (var index = 0; index < _pages.Count; index++)
            {
                var sheet = _pages[index];
                var position = index;
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Class="pa-2" Outlined data-testid="camera-page">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption"><b>@L["CameraPage", position + 1]</b></MudText>
                            <div class="mydocs-camera-frame">
                                <img src="@sheet.Url" alt="@L["CameraPage", position + 1]" style="@sheet.Style" />
                            </div>
                            <MudStack Row Spacing="0" Justify="Justify.Center" Wrap="Wrap.Wrap">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-label="@L["CameraUp"]" Disabled="@(position == 0)" OnClick="() => Move(position, -1)" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-label="@L["CameraDown"]" Disabled="@(position == _pages.Count - 1)" OnClick="() => Move(position, 1)" />
                                <MudIconButton Icon="@Icons.Material.Filled.RotateLeft" Size="Size.Small" aria-label="@L["CameraRotateLeft"]" OnClick="() => sheet.Rotate(-90)" />
                                <MudIconButton Icon="@Icons.Material.Filled.RotateRight" Size="Size.Small" aria-label="@L["CameraRotateRight"]" OnClick="() => sheet.Rotate(90)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Crop" Size="Size.Small" aria-label="@L["CameraCrop"]" Color="@(sheet.Cropping ? Color.Primary : Color.Default)"
                                               OnClick="() => sheet.Cropping = !sheet.Cropping" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" aria-label="@L["CameraRemove"]" OnClick="() => RemoveAsync(sheet)" />
                            </MudStack>
                            @if (sheet.Cropping)
                            {
                                <MudSlider T="int" @bind-Value="sheet.Top" Min="0" Max="45" Size="Size.Small">@L["CameraCropTop"]</MudSlider>
                                <MudSlider T="int" @bind-Value="sheet.Bottom" Min="0" Max="45" Size="Size.Small">@L["CameraCropBottom"]</MudSlider>
                                <MudSlider T="int" @bind-Value="sheet.Left" Min="0" Max="45" Size="Size.Small">@L["CameraCropLeft"]</MudSlider>
                                <MudSlider T="int" @bind-Value="sheet.Right" Min="0" Max="45" Size="Size.Small">@L["CameraCropRight"]</MudSlider>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudSwitch T="bool" @bind-Value="_household" Color="Color.Primary" Label="@L["InboxForHousehold"]" />
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="SaveAsync" Disabled="_busy" data-testid="camera-save">
                @L["CameraSave", _pages.Count]
            </MudButton>
        </MudStack>
    }
    @if (_busy)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
</MudStack>

@code {
    private readonly List<CameraPageState> _pages = [];
    private IJSObjectReference? _module;
    private InputFile? _take, _pick;
    private bool _busy, _household;

    private sealed record AddedPage(int Id, string Url, int Width, int Height);

    private async Task<IJSObjectReference> ModuleAsync() =>
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/MyDocs.UI/js/mydocs.camera.js");

    private async Task AddAsync(InputFileChangeEventArgs args)
    {
        var module = await ModuleAsync();
        // Welches der beiden Felder gewählt wurde, verrät das Ereignis nicht; beide abfragen, das andere ist leer.
        var added = new List<AddedPage>();
        foreach (var input in new[] { _take?.Element, _pick?.Element })
        {
            if (input is { } element)
            {
                added.AddRange(await module.InvokeAsync<List<AddedPage>>("add", element));
            }
        }

        foreach (var page in added)
        {
            if (_pages.Count >= CameraLimits.MaxPages)
            {
                Snackbar.Add(L["CameraTooMany", CameraLimits.MaxPages], Severity.Warning);
                await module.InvokeVoidAsync("remove", page.Id);
                continue;
            }

            _pages.Add(new CameraPageState(page.Id, page.Url));
        }
    }

    private void Move(int index, int by)
    {
        var page = _pages[index];
        _pages.RemoveAt(index);
        _pages.Insert(index + by, page);
    }

    private async Task RemoveAsync(CameraPageState page)
    {
        _pages.Remove(page);
        await (await ModuleAsync()).InvokeVoidAsync("remove", page.Id);
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var module = await ModuleAsync();
            var jpegs = new List<byte[]>();
            foreach (var page in _pages)
            {
                jpegs.Add(await module.InvokeAsync<byte[]>("exportPage", page.Id, page.Rotation, page.Left / 100d, page.Top / 100d, page.Right / 100d, page.Bottom / 100d));
            }

            var item = await Inbox.UploadCameraAsync(jpegs, _household);
            Snackbar.Add(L["CameraSaved", _pages.Count], Severity.Success);
            await module.InvokeVoidAsync("clear");
            _pages.Clear();
            Navigation.NavigateTo($"inbox?document={item.Id}");
        }
        catch (ApiException exception)
        {
            Snackbar.Add(L[$"DocumentError_{exception.Code}"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("clear");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <summary>Eine Seite: Drehung in 90-Grad-Schritten und Zuschnitt in Prozent je Rand.</summary>
    private sealed class CameraPageState(int id, string url)
    {
        public int Id { get; } = id;

        public string Url { get; } = url;

        public int Rotation { get; private set; }

        public bool Cropping { get; set; }

        public int Top { get; set; }

        public int Bottom { get; set; }

        public int Left { get; set; }

        public int Right { get; set; }

        public void Rotate(int by) => Rotation = ((Rotation + by) % 360 + 360) % 360;

        /// <summary>Vorschau: erst zuschneiden (clip-path am Original), dann drehen.</summary>
        public string Style => FormattableString.Invariant($"transform: rotate({Rotation}deg); clip-path: inset({Top}% {Right}% {Bottom}% {Left}%);");
    }
}

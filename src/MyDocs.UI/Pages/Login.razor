@page "/login"
@layout CenteredLayout
@inject IStringLocalizer<SharedResource> L
@inject AuthClient Auth
@inject SessionService Session
@inject NavigationManager Navigation

<PageTitle>@L["AppName"] – @L["LoginTitle"]</PageTitle>

<MudPaper Class="pa-6" Elevation="1">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">@L["LoginTitle"]</MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-testid="login-error">@L[$"AuthError_{_error}"]</MudAlert>
    }

    @if (!_secondStep)
    {
        <EditForm Model="this" OnSubmit="LoginAsync">
            <MudStack Spacing="3">
                <MudTextField T="string" @bind-Value="_email" Label="@L["Email"]" Variant="Variant.Outlined" InputType="InputType.Email"
                              UserAttributes="@(new() { ["autocomplete"] = "username", ["data-testid"] = "login-email" })" Required />
                <MudTextField T="string" @bind-Value="_password" Label="@L["Password"]" Variant="Variant.Outlined" InputType="InputType.Password"
                              UserAttributes="@(new() { ["autocomplete"] = "current-password", ["data-testid"] = "login-password" })" Required />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" data-testid="login-submit">@L["LoginNext"]</MudButton>
            </MudStack>
        </EditForm>
    }
    else
    {
        <EditForm Model="this" OnSubmit="SecondFactorAsync">
            <MudStack Spacing="3">
                <MudText>@(_recovery ? L["LoginRecoveryText"] : L["LoginTotpText"])</MudText>
                <MudTextField T="string" @bind-Value="_code" Label="@(_recovery ? L["RecoveryCode"] : L["TotpCode"])" Variant="Variant.Outlined"
                              UserAttributes="@(new() { ["autocomplete"] = "one-time-code", ["inputmode"] = _recovery ? "text" : "numeric", ["data-testid"] = "login-code" })" Required />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" data-testid="login-code-submit">@L["LoginSubmit"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="ToggleRecovery">@(_recovery ? L["LoginUseTotp"] : L["LoginUseRecovery"])</MudButton>
            </MudStack>
        </EditForm>
    }
</MudPaper>

@code {
    private string? _email;
    private string? _password;
    private string? _code;
    private bool _secondStep;
    private bool _recovery;
    private bool _busy;
    private string? _error;

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if ((await Auth.GetSetupStatusAsync()).Required)
            {
                Navigation.NavigateTo("setup");
            }
        }
        catch (HttpRequestException)
        {
            _error = "server-unreachable";
        }
    }

    private async Task LoginAsync() => await RunAsync(async () =>
    {
        var result = await Auth.LoginAsync(new(_email ?? string.Empty, _password ?? string.Empty));
        _password = null;
        _secondStep = result.TwoFactorRequired;
    });

    private async Task SecondFactorAsync() => await RunAsync(async () =>
    {
        await Auth.LoginTwoFactorAsync(new(_code ?? string.Empty, _recovery));
        await Session.RefreshAsync();
        Navigation.NavigateTo(SafeReturnUrl);
    });

    private void ToggleRecovery()
    {
        _recovery = !_recovery;
        _code = null;
        _error = null;
    }

    /// <summary>Nur Adressen innerhalb der App, kein Weiterleiten auf fremde Seiten.</summary>
    private string SafeReturnUrl => ReturnUrl is { Length: > 0 } url && !url.Contains("//", StringComparison.Ordinal) && !url.Contains(':', StringComparison.Ordinal) ? url : string.Empty;

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            _error = exception.Code;
            _code = null;
        }
        catch (HttpRequestException)
        {
            _error = "server-unreachable";
        }
        finally
        {
            _busy = false;
        }
    }
}

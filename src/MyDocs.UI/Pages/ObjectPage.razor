@page "/object/new/{TypeKey}"
@page "/object/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResource> L
@inject CatalogText Catalog
@inject ObjectDirectory Directory
@inject ObjectClient Objects
@inject SessionService Session
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject TaskClient Tasks

<PageTitle>@L["AppName"] – @(_item?.Data.Title ?? (_type is null ? string.Empty : Catalog.Type(_type)))</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@L[$"ObjectError_{_error}"]</MudAlert>
}
else if (_type is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    <MudStack Spacing="3">
        <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 py-0" />
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@AreaIcons.For(_type.Area)" Color="Color.Primary" />
            <MudText Typo="Typo.h4" HtmlTag="h1">@(_editing ? (_item is null ? L["NewObject", Catalog.Type(_type)] : _draft!.Title) : _item!.Data.Title)</MudText>
            <MudSpacer />
            @if (!_editing && _item is not null)
            {
                @if (_item.DeletedAt is not null)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">@L["InTrash"]</MudChip>
                    @if (_item.CanManage)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RestoreFromTrash" OnClick="RestoreAsync" data-testid="object-restore">@L["Restore"]</MudButton>
                    }
                }
                else
                {
                    @if (_item.CanEdit)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="StartEdit" data-testid="object-edit">@L["Edit"]</MudButton>
                    }
                    @if (_item.CanManage)
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" aria-label="@L["Delete"]" OnClick="DeleteAsync" data-testid="object-delete" />
                    }
                }
            }
        </MudStack>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.caption" Class="mydocs-muted">@Catalog.Type(_type)</MudText>
            @if (_item?.LifecycleState is { } state)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(LifecycleStates.Inactive.Contains(state) ? Color.Default : state == LifecycleStates.Expired ? Color.Error : state is LifecycleStates.Cancelled or LifecycleStates.Expiring ? Color.Warning : Color.Success)"
                         data-testid="lifecycle-chip">
                    @L[$"Lifecycle_{state}"]@(_item.LifecycleDate is { } date ? $" · {date.ToString("d", CultureInfo.CurrentCulture)}" : string.Empty)
                </MudChip>
                @if (_item.CanEdit && Lifecycle.NextStates(_item.TypeKey, state).Count > 0)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.SwapHoriz" OnClick="LifecycleAsync" data-testid="lifecycle-change">@L["LifecycleChange"]</MudButton>
                }
                @if (_item.ReplacedById is { } successor)
                {
                    <MudLink Href="@($"object/{successor}")" Typo="Typo.caption">@L["LifecycleReplacedByLink", Directory.TitleOf(successor) ?? "?"]</MudLink>
                }
            }
            @if (!_editing && _item is { DeletedAt: null })
            {
                <MudSpacer />
                <MudTooltip Text="@L["MyLifeObjectHelp"]">
                    <MudSwitch T="bool" Value="_item.MyLife" ValueChanged="SetMyLifeAsync" Disabled="@(!_item.CanEdit || _busy)" Color="Color.Primary"
                               Label="@L["MyLifeObjectSwitch"]" data-testid="object-mylife" />
                </MudTooltip>
            }
        </MudStack>

        @if (_editing)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <EditForm Model="_draft" OnSubmit="SaveAsync">
                    <ObjectEditor Type="_type" Data="_draft!" ObjectId="_item?.Id" @bind-Owner="_owner" @bind-Responsible="_responsible"
                                  MyPersonId="Session.Me?.PersonId" CanChangeOwner="CanChangeOwner" Errors="_errors" />
                    <MudStack Row Class="mt-4" Spacing="2">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" data-testid="object-save">@L["Save"]</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="Cancel">@L["Cancel"]</MudButton>
                    </MudStack>
                </EditForm>
            </MudPaper>
        }
        else if (_item is not null)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <ObjectDatasheet Type="_type" Item="_item" />
            </MudPaper>

            @if (_item.DeletedAt is null && (_item.Review is not null || MyDocs.Shared.Objects.ReviewRules.DefaultIntervalMonths(_item.TypeKey) is not null || Lifecycle.PatternOf(_item.TypeKey) != LifecyclePattern.None))
            {
                <ReviewPanel Item="_item" ItemChanged="item => _item = item" OnTaskCreated="LoadTasksAsync" />
            }

            <DocumentList ObjectId="_item.Id" CanEdit="_item.CanEdit" />

            <MudPaper Class="pa-4" Elevation="1" data-testid="object-tasks">
                <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h2"><b>@L["TasksTitle"]</b></MudText>
                    <MudSpacer />
                    @if (_item.CanEdit)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewTaskAsync" data-testid="object-task-new">@L["TaskNew"]</MudButton>
                    }
                </MudStack>
                <TaskTable Items="_tasks" ShowObjects="false" OnChanged="LoadTasksAsync" />
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-2"><b>@L["CommentsTitle"]</b></MudText>
                <CommentList Comments="_comments" CanWrite="_item.CanEdit" OnAdd="AddCommentAsync" OnDelete="DeleteCommentAsync" />
            </MudPaper>

            @if (_item.OwnerPersonId is not null && _item.OwnerPersonId == Session.Me?.PersonId && _item.DeletedAt is null)
            {
                <MudPaper Class="pa-4" Elevation="1" data-testid="object-shares">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h2"><b>@L["SharesTitle"]</b></MudText>
                    <MudText Typo="Typo.body2" Class="mydocs-muted mb-2">@L["SharesIntro"]</MudText>
                    @foreach (var person in Directory.Accounts.Where(p => p.UserId != Session.Me?.Id))
                    {
                        var share = _item.Shares.FirstOrDefault(s => s.UserId == person.UserId);
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Style="min-width: 12rem">@person.DisplayName</MudText>
                            <MudSelect T="string" Value="@(share is null ? "none" : share.CanEdit ? "edit" : "read")" ValueChanged="v => ShareAsync(person.UserId!.Value, v)"
                                       Dense Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 14rem">
                                <MudSelectItem T="string" Value="@("none")">@L["ShareNone"]</MudSelectItem>
                                <MudSelectItem T="string" Value="@("read")">@L["ShareRead"]</MudSelectItem>
                                <MudSelectItem T="string" Value="@("edit")">@L["ShareEdit"]</MudSelectItem>
                            </MudSelect>
                        </MudStack>
                    }
                </MudPaper>
            }

            <MudExpansionPanels Elevation="0" Outlined>
                <MudExpansionPanel Text="@L["HistoryTitle"]" ExpandedChanged="LoadHistoryAsync" data-testid="object-history">
                    @if (_history is null)
                    {
                        <MudProgressLinear Indeterminate Color="Color.Primary" />
                    }
                    else
                    {
                        <MudSimpleTable Dense Elevation="0">
                            <tbody>
                                @foreach (var entry in _history)
                                {
                                    <tr>
                                        <td class="mydocs-muted" style="white-space: nowrap">@entry.At.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</td>
                                        <td>@entry.ActorName</td>
                                        <td>@FieldName(entry.Field)</td>
                                        <td>@HistoryValue(entry.Field, entry.OldValue) → @HistoryValue(entry.Field, entry.NewValue)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudStack>
}

@code {
    private ObjectTypeDefinition? _type;
    private ObjectDto? _item;
    private ObjectData? _draft;
    private Guid? _owner;
    private Guid? _responsible;
    private bool _editing;
    private bool _busy;
    private string? _error;
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private List<ObjectHistoryDto>? _history;
    private List<BreadcrumbItem> _breadcrumbs = [];
    private List<TaskDto>? _tasks;
    private List<CommentDto> _comments = [];

    [Parameter] public string? TypeKey { get; set; }

    [Parameter] public Guid? Id { get; set; }

    /// <summary>Eigentum ändern: beim Anlegen frei; danach privat → Haushalt durch den Eigentümer, Haushalt → privat nur durch die zuständige Person (34).</summary>
    private bool CanChangeOwner => _item is null
        || (_item.OwnerPersonId is null ? _item.ResponsiblePersonId == Session.Me?.PersonId : _item.OwnerPersonId == Session.Me?.PersonId);

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _history = null;
        try
        {
            await Session.GetAuthenticationStateAsync();
            await Directory.LoadAsync();
            if (Id is { } id)
            {
                _item = await Objects.GetAsync(id);
                _type = MyDocsCatalog.Find(_item.TypeKey);
                _editing = false;
                await LoadTasksAsync();
                _comments = await Tasks.ObjectCommentsAsync(id);
            }
            else
            {
                _type = MyDocsCatalog.Find(TypeKey);
                _item = null;
                _draft = new ObjectData();
                _owner = null;
                _responsible = Session.Me?.PersonId;
                _editing = true;
            }

            if (_type is null)
            {
                _error = ObjectErrors.TypeUnknown;
                return;
            }

            _breadcrumbs = [new(L["NavHome"], ""), new(Catalog.Area(_type.Area), $"area/{_type.Area}"), new(_item?.Data.Title ?? Catalog.Type(_type), null, disabled: true)];
        }
        catch (ApiException exception)
        {
            _error = exception.Code;
        }
    }

    [Inject] private MyLifeClient MyLife { get; set; } = default!;

    /// <summary>„In myLife führen“ (57) umschalten; geht nicht über das Formular, damit es auch ohne Bearbeiten geht.</summary>
    private async Task SetMyLifeAsync(bool enabled)
    {
        _busy = true;
        try
        {
            await MyLife.SetObjectAsync(_item!.Id, enabled);
            _item = _item with { MyLife = enabled };
        }
        catch (ApiException exception)
        {
            Snackbar.Add(L[$"ObjectError_{exception.Code}"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadTasksAsync()
    {
        if (_item is not null)
        {
            _tasks = await Tasks.ForObjectAsync(_item.Id);
        }
    }

    private async Task LifecycleAsync()
    {
        var parameters = new DialogParameters<LifecycleDialog> { { d => d.Item, _item! } };
        var dialog = await Dialogs.ShowAsync<LifecycleDialog>(L["LifecycleChange"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: LifecycleChangeRequest request })
        {
            return;
        }

        try
        {
            _item = await Tasks.ChangeLifecycleAsync(_item!.Id, request);
            _history = null;
            await LoadTasksAsync();
            Snackbar.Add(L["ObjectSaved"], Severity.Success);
        }
        catch (ApiException exception)
        {
            Snackbar.Add(L[$"ObjectError_{exception.Code}"], Severity.Error);
        }
    }

    private async Task NewTaskAsync()
    {
        var parameters = new DialogParameters<TaskDialog>
        {
            { d => d.ObjectIds, [_item!.Id] },
            { d => d.DefaultResponsible, _item.ResponsiblePersonId ?? Session.Me?.PersonId },
        };
        var dialog = await Dialogs.ShowAsync<TaskDialog>(L["TaskNew"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            await LoadTasksAsync();
        }
    }

    private async Task AddCommentAsync(string text)
    {
        await Tasks.AddObjectCommentAsync(_item!.Id, text);
        _comments = await Tasks.ObjectCommentsAsync(_item.Id);
    }

    private async Task DeleteCommentAsync(CommentDto comment)
    {
        await Tasks.DeleteCommentAsync(comment.Id);
        _comments = await Tasks.ObjectCommentsAsync(_item!.Id);
    }

    private void StartEdit()
    {
        _draft = _item!.Data.Clone();
        _owner = _item.OwnerPersonId;
        _responsible = _item.ResponsiblePersonId;
        _errors = new Dictionary<string, string>();
        _editing = true;
    }

    private void Cancel()
    {
        if (_item is null)
        {
            Navigation.NavigateTo($"area/{_type!.Area}");
            return;
        }

        _editing = false;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var request = new ObjectSaveRequest(_type!.Key, _draft!, _owner, _responsible, _item?.Version ?? 0);
            if (_item is null)
            {
                var created = await Objects.CreateAsync(request);
                Snackbar.Add(L["ObjectSaved"], Severity.Success);
                Navigation.NavigateTo($"object/{created.Id}");
                return;
            }

            _item = await Objects.UpdateAsync(_item.Id, request);
            await Directory.LoadAsync();
            _editing = false;
            _history = null;
            Snackbar.Add(L["ObjectSaved"], Severity.Success);
        }
        catch (ObjectValidationException exception)
        {
            _errors = exception.Errors;
            Snackbar.Add(L["ObjectError_invalid"], Severity.Warning);
        }
        catch (ApiException exception)
        {
            Snackbar.Add(L[$"ObjectError_{exception.Code}"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync(L["Delete"], L["ObjectDeleteConfirm", _item!.Data.Title].Value, L["Delete"], L["Cancel"]) != true)
        {
            return;
        }

        await Objects.DeleteAsync(_item.Id);
        Snackbar.Add(L["ObjectDeleted"], Severity.Info);
        Navigation.NavigateTo($"area/{_type!.Area}");
    }

    private async Task RestoreAsync()
    {
        _item = await Objects.RestoreAsync(_item!.Id);
        await Directory.LoadAsync();
        Snackbar.Add(L["ObjectRestored"], Severity.Success);
    }

    private async Task ShareAsync(Guid userId, string level)
    {
        var shares = _item!.Shares.Where(s => s.UserId != userId).ToList();
        if (level != "none")
        {
            shares.Add(new ObjectShareDto(userId, level == "edit"));
        }

        _item = await Objects.SetSharesAsync(_item.Id, shares);
    }

    private async Task LoadHistoryAsync(bool expanded)
    {
        if (expanded && _history is null && _item is not null)
        {
            _history = await Objects.HistoryAsync(_item.Id);
        }
    }

    private string FieldName(string field) => field switch
    {
        "title" => L["ObjectTitle"],
        "notes" => L["Notes"],
        "expiresOn" => Catalog.Expiry(_type!),
        "owner" => L["ObjectOwner"],
        "responsible" => L["ObjectResponsible"],
        "deleted" => L["InTrash"],
        "lifecycle" => L["LifecycleLabel"],
        "reviewed" => L["ReviewLast"],
        "reviewInterval" => L["ReviewIntervalMonths"],
        "nextReview" => L["ReviewFixedDate"],
        "lifecycleDate" => L["LifecycleDateLabel"],
        _ when field.StartsWith("field:", StringComparison.Ordinal) && _type!.Field(field[6..]) is { } definition => Catalog.Field(_type, definition),
        _ => field,
    };

    private string HistoryValue(string field, string? value)
    {
        if (value is null)
        {
            return "–";
        }

        return field switch
        {
            "owner" or "responsible" => Directory.PersonName(Guid.TryParse(value, out var person) ? person : null) ?? value,
            "deleted" => L["Yes"],
            "lifecycle" => L[$"Lifecycle_{value}"],
            "reviewed" => L[$"TaskOutcome_{value}"],
            _ when field.StartsWith("field:", StringComparison.Ordinal) && _type!.Field(field[6..]) is { } definition => Catalog.Display(definition, value, Directory.TitleOf),
            _ => value,
        };
    }
}
